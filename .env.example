# ===== CONFIGURAÇÃO DO MONITOR =====
# Índice do monitor para captura (1, 2, 3, etc)
MONITOR_INDEX=1

# ===== ZONA DE LIMITE (ZONA DE INTERESSE) =====
# Define um retângulo fixo que marca a zona de limite/interesse
# Formato: "x1,y1,x2,y2" em coordenadas de pixel da tela
# 
# Exemplos:
# - Para tela 1920x1080 com margem: ZONE_OF_INTEREST=100,100,1820,1000
# - Para tela inteira: ZONE_OF_INTEREST=0,0,1920,1080
#
# Deixe em branco ou comente para desabilitar e usar toda a tela
ZONE_OF_INTEREST= 100,100,1820,1000
